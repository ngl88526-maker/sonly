{% assign variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'ProductForm-' | append: section.id %}
<div class="breadcrumbs"><a href="{{ routes.root_url }}">Home</a><span>/</span><span>{{ product.title | escape }}</span></div>
<section class="product-layout section-pad"><div class="product-gallery"><div class="product-image">{% render 'product-image', image: product.featured_image, eager: true %}<span class="image-tag">LAUNCH COLLECTION 001</span></div>{% if product.media.size > 1 %}<div class="gallery-details">{% for media in product.media offset: 1 %}<div>{% if media.media_type == 'image' %}{{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,900', sizes: '(max-width: 760px) 85vw, 25vw' }}{% elsif media.media_type == 'video' %}{{ media | video_tag: controls: true, preload: 'metadata', image_size: '900x' }}{% endif %}</div>{% endfor %}</div>{% endif %}</div>
<div class="product-info"><span class="eyebrow">THE CURRENT DROP · THEMED SOCKS</span><h1>{{ product.title | escape }}</h1><div class="product-price"><span class="live-price" data-price-display>{{ variant.price | money }}</span> <span>/ pair</span></div><div data-stock-note>{% render 'stock-note', variant: variant %}</div><div class="product-description">{% if product.description != blank %}{{ product.description }}{% else %}<p>One pair. Four colors. Zero boring ankles. Cloud-inspired crew socks with a soft combed cotton feel and a little extra character.</p>{% endif %}</div><div class="color-note"><span class="swatches" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Mystic Clouds colorway</div><div class="fit-note"><strong>One size · crew height</strong><span>22 cm flat foot length · 22 cm leg length</span><a href="{{ routes.root_url }}pages/size-care">Check the fit guide {% render 'arrow' %}</a><p>{{ section.settings.fit_note | escape }}</p></div>
{% form 'product', product, id: product_form_id, class: 'purchase-form' %}
  {{ form.errors | default_errors }}
  {% if product.variants.size == 1 %}<input type="hidden" name="id" value="{{ variant.id }}" data-variant data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}">{% else %}<label for="Variant">Choose an option</label><select name="id" id="Variant" data-variant>{% for item in product.variants %}<option data-price="{{ item.price | money | escape }}" data-available="{{ item.available }}" value="{{ item.id }}" {% if item == variant %}selected{% endif %} {% unless item.available %}disabled{% endunless %}>{{ item.title | escape }} — {{ item.price | money }}{% unless item.available %} — Sold out{% endunless %}</option>{% endfor %}</select>{% endif %}
  <fieldset class="quantity-options"><legend>MAKE IT A PAIR. OR A FEW.</legend><div class="quantity-grid">{% for count in (1..3) %}<label class="quantity-choice"><input type="radio" name="quantity" value="{{ count }}" {% if count == 1 %}checked{% endif %}><span><strong>{{ count }} {% if count == 1 %}pair{% else %}pairs{% endif %}</strong><small>{% case count %}{% when 1 %}Your everyday{% when 2 %}One to give{% when 3 %}Stock your drawer{% endcase %}</small></span></label>{% endfor %}</div></fieldset>
  <div class="gift-options" id="gifting"><label class="check"><input type="checkbox" name="properties[Hide packing-slip prices]" value="Yes"> This is a gift — hide packing-slip prices</label><label for="GiftMessage">A little note for them <span>(optional)</span></label><textarea id="GiftMessage" name="properties[Gift message]" maxlength="240" rows="2" placeholder="Good socks for a good human."></textarea></div>
  <button class="button navy full" type="submit" name="add" data-add-button {% unless variant.available %}disabled{% endunless %}><span data-button-label>{% if variant.available %}Add to bag{% else %}Currently sold out{% endif %}</span> {% render 'arrow' %}</button><p class="purchase-status" role="status" aria-live="polite"></p><p class="fine">Taxes, shipping and eligible discounts are confirmed at secure checkout.</p>
{% endform %}
{% render 'shop-trust' %}
<div class="product-accordions"><details open><summary>The good details</summary><p>{{ section.settings.details | escape }}</p></details><details><summary>Size & care</summary><p>{{ section.settings.care | escape }}</p><a href="{{ routes.root_url }}pages/size-care">See the full guide</a></details><details><summary>Delivery & returns</summary><p>Shipping services, rates and taxes are confirmed at checkout. See our store policies for return eligibility and instructions.</p><a href="{{ routes.root_url }}pages/help">Get help with an order</a></details></div>
{% for block in section.blocks %}{% render block %}{% endfor %}
</div></section>
<div class="mobile-purchase" data-mobile-purchase><div><strong>{{ product.title | escape }}</strong><span><span data-sticky-price>{{ variant.price | money }}</span> / pair</span></div><button type="submit" name="add" form="{{ product_form_id }}" class="button navy" data-add-button {% unless variant.available %}disabled{% endunless %}><span data-button-label>{% if variant.available %}Add to bag{% else %}Sold out{% endif %}</span>{% render 'arrow' %}</button></div>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}{"name":"Product","settings":[{"type":"textarea","id":"fit_note","label":"Fit note — confirm before launch","default":"Shoe-size range is awaiting wearer testing. Please compare measurements before ordering."},{"type":"textarea","id":"details","label":"Construction details","default":"168-needle jacquard knit with a hand-linked seamless toe. Reinforced solid navy heels and smoke-blue toes. Pattern knit into the fabric."},{"type":"textarea","id":"care","label":"Materials and care — confirm before launch","default":"Follow your garment label. Final fiber percentages and washing instructions must be confirmed with the factory before launch."}],"blocks":[{"type":"@app"}]}{% endschema %}
