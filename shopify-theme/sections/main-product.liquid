{% if product == blank %}{% assign product = settings.featured_product | default: all_products['mystic-clouds'] %}{% endif %}
{% if product != blank %}
{% assign variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'ProductForm-' | append: section.id %}
{% assign is_home = false %}{% if request.page_type == 'index' %}{% assign is_home = true %}{% endif %}
<section class="studio-product{% if is_home %} studio-home{% else %} studio-pdp{% endif %}" id="TheDrop">
  <div class="studio-visual"><div class="visual-caption"><span>THE CURRENT DROP</span><span>SO–001</span></div><div class="studio-product-photo">{% if section.settings.product_image != blank %}{% render 'product-image', image: section.settings.product_image, eager: true %}{% elsif product.handle == 'mystic-clouds' or product.featured_image == blank %}<img src="{{ 'mystic-cutout-900.webp' | asset_url }}" srcset="{{ 'mystic-cutout-480.webp' | asset_url }} 480w, {{ 'mystic-cutout-900.webp' | asset_url }} 900w, {{ 'mystic-cutout-1200.webp' | asset_url }} 1200w" sizes="(max-width: 760px) 88vw, 45vw" width="1200" height="1200" alt="Mystic Clouds crew sock pair in navy, smoke blue, coral and lilac; background-cleaned product mockup" fetchpriority="high">{% else %}{% render 'product-image', image: product.featured_image, eager: true %}{% endif %}</div><div class="visual-bottom"><span>MYSTIC CLOUDS</span><span>NAVY / BLUE / CORAL / LILAC</span></div><span class="visual-sticker" aria-hidden="true">LOOK DOWN.<br><strong>STAND OUT.</strong><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v17m-7-7 7 7 7-7"/></svg></span></div>
  <div class="studio-buy">
    <div class="studio-kicker"><span></span> THEMED SOCKS. SMALL RUNS.</div>
    {% if is_home %}<h1 class="studio-headline">Good socks.<br><span>Great energy.</span></h1>{% else %}<p class="studio-pretitle">A LITTLE EXTRA PERSONALITY.</p>{% endif %}
    <div class="studio-product-heading">{% if is_home %}<h2>{{ product.title | escape }}</h2>{% else %}<h1>{{ product.title | escape }}</h1>{% endif %}<div class="studio-price"><strong data-price-display>{{ variant.price | money }}</strong><span>/ pair</span></div></div>
    <p class="studio-description">{{ section.settings.summary | escape }}</p>
    {% render 'review-summary', product: product, show_rating: section.settings.show_rating %}
    <div data-stock-note>{% render 'stock-note', variant: variant %}</div>
    <div class="studio-fit"><span><span class="fit-dot"></span>One size · crew height</span><a href="{{ routes.root_url }}pages/size-care">Check your fit</a></div>
    <p class="studio-fit-note">{{ section.settings.fit_note | escape }}</p>
    {% form 'product', product, id: product_form_id, class: 'purchase-form' %}
      {{ form.errors | default_errors }}
      {% if product.variants.size == 1 %}<input type="hidden" name="id" value="{{ variant.id }}" data-variant data-price="{{ variant.price | money | escape }}" data-available="{{ variant.available }}">{% else %}<label for="Variant-{{ section.id }}">Choose an option</label><select name="id" id="Variant-{{ section.id }}" data-variant>{% for item in product.variants %}<option value="{{ item.id }}" data-price="{{ item.price | money | escape }}" data-available="{{ item.available }}"{% if item == variant %} selected{% endif %}{% unless item.available %} disabled{% endunless %}>{{ item.title | escape }} — {{ item.price | money }}</option>{% endfor %}</select>{% endif %}
      <div class="studio-purchase-row"><div class="studio-quantity"><label for="Quantity-{{ section.id }}">PAIRS</label><select id="Quantity-{{ section.id }}" name="quantity"><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></div><button class="studio-add" type="submit" name="add" data-add-button{% unless variant.available %} disabled{% endunless %}><span data-button-label>{% if variant.available %}Add to bag{% else %}Sold out{% endif %}</span>{% render 'studio-icon', name: 'arrow' %}</button></div>
      <p class="purchase-status" role="status" aria-live="polite"></p>
      <div class="studio-checkout-note">{% render 'studio-icon', name: 'lock' %}<span>Secure Shopify checkout · Shipping & tax before payment</span></div>
      <details class="studio-gift" id="gifting"><summary>Make it a gift <span>Optional note & packing slip</span></summary><div class="gift-options"><label class="check"><input type="checkbox" name="properties[Hide packing-slip prices]" value="Yes"> Hide packing-slip prices</label><label for="GiftMessage-{{ section.id }}">Your message</label><textarea id="GiftMessage-{{ section.id }}" name="properties[Gift message]" rows="2" maxlength="240" placeholder="Good socks for a good human."></textarea></div></details>
    {% endform %}
    {% if section.settings.shipping_note != blank or section.settings.returns_note != blank %}<div class="purchase-policy-note">{% if section.settings.shipping_note != blank %}<p>{{ section.settings.shipping_note | escape }}</p>{% endif %}{% if section.settings.returns_note != blank %}<p>{{ section.settings.returns_note | escape }}</p>{% endif %}</div>{% endif %}
    <div class="studio-details"><details><summary>The good details</summary>{% if product.description != blank %}<div class="studio-richtext">{{ product.description }}</div>{% endif %}<p>{{ section.settings.details | escape }}</p></details><details><summary>Fit & care</summary><p>{{ section.settings.care | escape }}</p><a href="{{ routes.root_url }}pages/size-care">Measurements & fit guide</a></details><details><summary>Delivery & returns</summary><p>Available shipping services, tax and final total are shown at checkout before payment.</p>{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Shipping policy</a>{% endif %}{% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">Return terms</a>{% endif %}<a href="{{ routes.root_url }}pages/help">Ask us a question</a></details></div>
    {% if section.blocks.size > 0 %}<div class="product-app-content" id="ProductReviews-{{ section.id }}">{% for block in section.blocks %}{% render block %}{% endfor %}</div>{% endif %}
  </div>
</section>
<div class="studio-proof"><div>{% render 'studio-icon', name: 'soft' %}<span>Soft combed cotton</span></div><div>{% render 'studio-icon', name: 'knit' %}<span>Pattern knitted in</span></div><div>{% render 'studio-icon', name: 'seam' %}<span>Hand-linked seamless toe</span></div></div>
{% if product.media.size > 1 %}<section class="studio-media"><span class="studio-kicker">A CLOSER LOOK</span><div class="studio-media-grid">{% for media in product.media offset: 1 %}<div>{% if media.media_type == 'image' %}{{ media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,900', sizes: '(max-width: 760px) 75vw, 30vw' }}{% elsif media.media_type == 'video' %}{{ media | video_tag: controls: true, preload: 'metadata', image_size: '900x' }}{% endif %}</div>{% endfor %}</div></section>{% endif %}
<script type="application/ld+json">{{ product | structured_data }}</script>
{% else %}<section class="studio-empty"><span class="studio-kicker">THEMED SOCKS. SMALL RUNS.</span><h1>Good socks.<br>Coming soon.</h1><p>The next drop is on its way.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the socks</a></section>{% endif %}
{% schema %}{
  "name": "Product",
  "settings": [
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Product presentation image",
      "info": "Optional. A transparent Mystic Clouds mockup is bundled. Upload approved photography to replace it."
    },
    {
      "type": "textarea",
      "id": "summary",
      "label": "Short product promise",
      "default": "Cloud-inspired crew socks. Soft combed cotton. A seamless toe.",
      "info": "Keep to one or two sentences. Test one copy change at a time."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show real review rating",
      "default": true,
      "info": "Only appears when a review app populates the standard Shopify rating and rating_count metafields."
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Confirmed shipping summary",
      "info": "Optional. Enter only an actual configured rate or delivery promise; leave blank until confirmed."
    },
    {
      "type": "text",
      "id": "returns_note",
      "label": "Confirmed returns summary",
      "info": "Optional. Must match your published refund policy, including eligibility."
    },
    {
      "type": "textarea",
      "id": "fit_note",
      "label": "Fit note \u2014 confirm before launch",
      "default": "Shoe-size range is awaiting wearer testing. Please compare measurements before ordering."
    },
    {
      "type": "textarea",
      "id": "details",
      "label": "Construction details",
      "default": "168-needle jacquard knit with a hand-linked seamless toe. Reinforced solid navy heels and smoke-blue toes. Pattern knit into the fabric."
    },
    {
      "type": "textarea",
      "id": "care",
      "label": "Materials and care \u2014 confirm before launch",
      "default": "Follow your garment label. Final fiber percentages and washing instructions must be confirmed with the factory before launch."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
