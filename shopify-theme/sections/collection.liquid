<section class="section-pad"><span class="eyebrow">ONLY THE GOOD STUFF.</span><h1>{{ collection.title | default: 'The socks' | escape }}</h1>{{ collection.description }}{% paginate collection.products by 12 %}<div class="collection-grid">{% for product in collection.products %}<a class="collection-card" href="{{ product.url }}">{% render 'product-image', image: product.featured_image %}<h2>{{ product.title | escape }}</h2><p>{{ product.price | money }}{% unless product.available %} · Sold out{% endunless %}</p></a>{% else %}<p>Our first pairs are coming soon.</p>{% endfor %}</div>{{ paginate | default_pagination }}{% endpaginate %}</section>
{% schema %}{"name":"Collection","settings":[]}{% endschema %}
