{% assign featured = settings.featured_product | default: all_products['mystic-clouds'] %}
{% assign shop_link = featured.url | default: routes.all_products_collection_url %}
{% if section.settings.show_announcement and section.settings.announcement != blank %}<div class="announcement simple-announcement"><span>{{ section.settings.announcement | escape }}</span></div>{% endif %}
<header class="header">
  <a class="wordmark brand-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{% render 'brand-logo' %}</a>
  <nav aria-label="Main navigation">
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}<a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endfor %}
    {% else %}
      <a href="{{ shop_link }}">Shop</a><a href="{{ routes.root_url }}pages/help">Help</a>
    {% endif %}
  </nav>
  <div class="header-actions">
    <a class="bag-button" href="{{ routes.cart_url }}">Bag <span>{{ cart.item_count }}</span></a>
    <button class="mobile-menu" type="button" data-menu-toggle aria-expanded="false" aria-controls="MobileNav">Menu</button>
  </div>
</header>
<nav id="MobileNav" class="mobile-nav" aria-label="Mobile navigation" hidden>
  {% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ shop_link }}">Shop</a><a href="{{ routes.root_url }}pages/size-care">Size guide</a><a href="{{ routes.root_url }}pages/help">Help</a>{% endif %}
  {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Your account</a>{% endif %}
</nav>
{% schema %}
{"name":"Header","settings":[{"type":"checkbox","id":"show_announcement","label":"Show announcement","default":false},{"type":"text","id":"announcement","label":"Announcement","default":"GOOD SOCKS. BETTER DAYS."},{"type":"link_list","id":"menu","label":"Navigation menu"}]}
{% endschema %}
