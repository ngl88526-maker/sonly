<footer class="simple-footer">
  <div class="simple-footer-top"><a class="wordmark brand-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">{% render 'brand-logo' %}</a><nav aria-label="Footer"><a href="{{ routes.root_url }}pages/size-care">Size & care</a><a href="{{ routes.root_url }}pages/help">Shipping & returns</a><a href="{{ routes.root_url }}pages/our-story">Our story</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Your orders</a>{% endif %}</nav></div>
  <details class="footer-signup" id="newsletter"><summary>Hear about the next drop</summary>{% form 'customer', id: 'FooterNewsletter' %}<input type="hidden" name="contact[tags]" value="newsletter,sockonly"><label for="FooterEmail">Email address</label><div class="footer-email-row"><input id="FooterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="you@example.com"><button class="button secondary" type="submit">Join</button></div><label class="check"><input type="checkbox" name="contact[accepts_marketing]" value="true" required> Send me SockOnly product news. Unsubscribe anytime.</label>{% if form.posted_successfully? %}<p role="status">Thanks for signing up. Check your inbox for confirmation if required.</p>{% endif %}{{ form.errors | default_errors }}{% endform %}</details>
  <div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.</span><div>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div><span>{{ cart.currency.iso_code }}</span></div>
</footer>
{% schema %}{"name":"Footer","settings":[]}{% endschema %}
