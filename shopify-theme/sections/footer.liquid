<footer class="studio-footer"><div class="studio-footer-main"><div class="footer-brand"><a class="brand-logo" href="{{ routes.root_url }}" aria-label="Sock Only home">{% render 'brand-logo' %}</a><p>For feet with personality.</p></div><div class="footer-next"><span class="studio-kicker">KEEP YOUR FEET IN THE LOOP.</span><details id="newsletter"><summary>Be first for the next drop {% render 'studio-icon', name: 'arrow' %}</summary>{% form 'customer', id: 'FooterNewsletter' %}<input type="hidden" name="contact[tags]" value="newsletter,sockonly"><label for="FooterEmail">Email address</label><div class="footer-email-row"><input id="FooterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="you@example.com"><button type="submit" class="button">Join</button></div><label class="check"><input type="checkbox" name="contact[accepts_marketing]" value="true" required> Send me SockOnly product news. Unsubscribe anytime.</label>{% if form.posted_successfully? %}<p data-form-result role="status">Thanks. Look out for confirmation if required.</p>{% endif %}{% if form.errors %}<div data-form-result role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</details></div></div><div class="studio-footer-bottom"><span>© {{ 'now' | date: '%Y' }} Sock Only</span><nav aria-label="Footer"><a href="{{ routes.root_url }}pages/size-care">Size & care</a><a href="{{ routes.root_url }}pages/help">Shipping & returns</a><a href="{{ routes.root_url }}pages/our-story">Our story</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Your orders</a>{% endif %}{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav><span>{{ cart.currency.iso_code }}</span></div></footer>
{% schema %}{"name":"Footer","settings":[]}{% endschema %}
