<footer>
  <div class="footer-top"><a class="wordmark" href="{{ routes.root_url }}">sockonly</a><p>A little more personality.<br>A lot less boring.</p><a class="footer-shop" href="{{ routes.all_products_collection_url }}">Find your cloud {% render 'arrow' %}</a></div>
  <div class="footer-links"><div><b>THE GOOD STUFF</b><a href="{{ routes.all_products_collection_url }}">The socks</a><a href="{{ routes.root_url }}pages/our-story">Our story</a></div><div><b>HERE TO HELP</b><a href="{{ routes.root_url }}pages/size-care">Size & care</a><a href="{{ routes.root_url }}pages/help">Shipping, returns & contact</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Account & order tracking</a>{% endif %}</div><div><b>LET’S KEEP IN TOUCH</b><p>New socks. Occasional notes. No cold feet.</p><a href="{{ routes.root_url }}#newsletter">Join the list {% render 'arrow' %}</a></div></div>
  <div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}.</span><div>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</div><span>{{ localization.country.name | escape }} · {{ cart.currency.iso_code }}</span></div>
</footer>
{% schema %}{"name":"Footer","settings":[]}{% endschema %}
