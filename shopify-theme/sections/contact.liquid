<section class="editorial-hero section-pad"><span class="eyebrow">NO COLD FEET HERE.</span><h1>{{ page.title | default: 'A little help. A human touch.' | escape }}</h1><p>Shipping questions, fit questions, or just a hello. You’re in the right place.</p></section><section class="info-columns section-pad"><div class="prose">{{ page.content }}{% for policy in shop.policies %}{% if policy.body != blank %}<p><a href="{{ policy.url }}">{{ policy.title | escape }}</a></p>{% endif %}{% endfor %}{% if shop.customer_accounts_enabled %}<a class="text-link" href="{{ routes.account_url }}">Your account & orders {% render 'arrow' %}</a>{% endif %}</div><div class="support-card"><h2>Drop us a note.</h2>{% form 'contact', id: 'ContactForm' %}{% if form.posted_successfully? %}<p role="status">Thanks. Your note has been sent. Please wait for return authorization before mailing any items.</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">Name</label><input id="ContactName" name="contact[name]" autocomplete="name" value="{{ form.name | default: customer.name | escape }}"><label for="ContactEmail">Email</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" required value="{{ form.email | default: customer.email | escape }}"><label for="ContactKind">What can we help with?</label><select id="ContactKind" name="contact[Request type]"><option>General question</option><option>Return request</option><option>Size exchange</option><option>Order tracking</option><option>Wholesale</option></select><label for="ContactOrder">Order number (for order help)</label><input id="ContactOrder" name="contact[Order number]" maxlength="80"><label for="ContactMessage">Your message</label><textarea id="ContactMessage" name="contact[body]" rows="5" required maxlength="2000">{{ form.body | escape }}</textarea><p class="fine">Please do not send payment details. Return requests are reviewed by our team.</p><button class="button navy full" type="submit">Send your note {% render 'arrow' %}</button>{% endform %}</div></section>
{% schema %}{"name":"Contact & returns","settings":[]}{% endschema %}
