{% assign featured = settings.featured_product | default: all_products['mystic-clouds'] %}
{% assign product_link = featured.url | default: routes.all_products_collection_url %}
<section class="hero">
  <div class="hero-copy"><div class="eyebrow"><span class="tiny-dot"></span> {{ section.settings.eyebrow | escape }}</div><h1>Socks.<br>Only socks.<br><em>Obsessively.</em></h1><p>{{ section.settings.intro | escape }}</p><a class="button" href="{{ product_link }}">Shop Mystic Clouds {% render 'arrow' %}</a><div class="hero-footnote"><span class="swatches" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>One pair. Four colors. Zero boring ankles.</span></div></div>
  <div class="hero-art"><span class="photo-label">MYSTIC CLOUDS / 001</span>{% assign hero_image = section.settings.image | default: featured.featured_image %}{% render 'product-image', image: hero_image, eager: true, class_name: 'hero-product' %}<div class="round-stamp">HEAD IN THE CLOUDS<br><svg width="32" height="24" viewBox="0 0 40 28" fill="none" stroke="currentColor" aria-hidden="true"><path d="M10 24a8 8 0 1 1 0-16 11 11 0 0 1 21 1 7.5 7.5 0 0 1 0 15z"/></svg><br>FEET ON THE GROUND</div><a class="image-caption" href="{{ product_link }}"><div><strong>Mystic Clouds</strong><span>Cloud-camouflage crew socks</span></div><span>{% if featured != blank %}{{ featured.price | money }}{% else %}Meet your pair{% endif %} {% render 'arrow' %}</span></a></div>
</section>
<section class="proof-strip" aria-label="Product features"><span>Combed cotton comfort</span><span>168-needle jacquard knit</span><span>Hand-linked seamless toe</span><span>A little more personality</span></section>
<section class="intro section-pad"><span class="eyebrow">LESS SCROLLING. MORE SOCKS.</span><h2>One really good pair.<br><span>Endless ways to wear it.</span></h2><p>Everyday essentials shouldn’t feel ordinary. Meet Mystic Clouds: thoughtful details, a cloud-inspired pattern, and comfort that goes with everything you do.</p><a class="text-link" href="{{ routes.root_url }}pages/our-story">The story behind the socks {% render 'arrow' %}</a></section>
<section class="feature-grid section-pad"><div class="detail-photo">{% render 'product-image', image: featured.featured_image, class_name: 'detail-crop' %}<span class="image-tag">IT’S ALL IN THE DETAILS.</span></div><div class="feature-copy"><span class="eyebrow">LOOK GOOD. FEEL EVEN BETTER.</span><h2>Big on character.<br>Soft on your feet.</h2><div class="feature-row"><span>01</span><div><h3>Soft, from the first step.</h3><p>Combed cotton yarn for a breathable, everyday feel.</p></div></div><div class="feature-row"><span>02</span><div><h3>Pattern with staying power.</h3><p>Clouds knit into the fabric. Never printed on top.</p></div></div><div class="feature-row"><span>03</span><div><h3>No rough edges.</h3><p>A hand-linked toe seam, plus reinforced heels and toes.</p></div></div><a class="text-link" href="{{ product_link }}">Meet your new everyday {% render 'arrow' %}</a></div></section>
<section class="gift-banner section-pad"><div class="gift-graphic" aria-hidden="true"><span>GOOD<br>SOCKS.</span><i>FOR GOOD PEOPLE.</i><div class="ribbon"></div></div><div><span class="eyebrow">GIVE A LITTLE CLOUD NINE.</span><h2>Great taste.<br>Easy gifting.</h2><p>For your favorite person. Or your other favorite person. Add a personal note and make their day.</p><a class="button navy" href="{{ product_link }}#gifting">Find a feel-good gift {% render 'arrow' %}</a></div></section>
{% schema %}{"name":"SockOnly homepage","settings":[{"type":"text","id":"eyebrow","label":"Collection label","default":"HELLO, LAUNCH COLLECTION 001"},{"type":"textarea","id":"intro","label":"Introduction","default":"Meet Mystic Clouds. A little color, a lot of comfort. Your everyday just got a little less everyday."},{"type":"image_picker","id":"image","label":"Hero image"}],"presets":[{"name":"SockOnly homepage"}]}{% endschema %}
