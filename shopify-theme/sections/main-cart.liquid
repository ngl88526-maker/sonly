<section class="section-pad cart-page"><span class="eyebrow">GOOD CHOICES IN HERE.</span><h1>Your bag.</h1>{% if cart.item_count == 0 %}<p>A little empty in here. Let’s put your feet on cloud nine.</p><a class="button navy" href="{{ routes.all_products_collection_url }}">Meet the socks {% render 'arrow' %}</a>{% else %}
<form action="{{ routes.cart_url }}" method="post" id="CartForm">
{% for item in cart.items %}<div class="cart-item"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 220 | image_tag: width: 110, height: 110, loading: 'lazy', alt: item.product.title }}{% endif %}</a><div><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p class="gift-message-preview">{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}<label for="Quantity-{{ forloop.index }}">Quantity</label><input id="Quantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" max="99" inputmode="numeric"><a class="remove-item" href="{{ item.url_to_remove }}">Remove</a></div><div><strong>{{ item.final_line_price | money }}</strong>{% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}{% for allocation in item.line_level_discount_allocations %}<p class="fine">{{ allocation.discount_application.title | escape }}</p>{% endfor %}</div></div>{% endfor %}
<div class="cart-summary"><label for="CartNote">Order note (optional)</label><textarea id="CartNote" name="note" maxlength="1000" rows="3">{{ cart.note | escape }}</textarea>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div class="subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money_with_currency }}</strong></div><p class="fine">Tax and shipping calculated at checkout. Enter promo codes at checkout.</p><button class="button secondary" type="submit" name="update">Update bag</button><button class="button navy" type="submit" name="checkout">Secure checkout {% render 'arrow' %}</button></div>
</form>
{% assign wrap_product = settings.gift_wrap_product | default: all_products['gift-wrap'] %}
{% assign has_wrap = false %}
{% for item in cart.items %}{% if item.product.id == wrap_product.id %}{% assign has_wrap = true %}{% endif %}{% endfor %}
{% if wrap_product.available and has_wrap == false and wrap_product.variants.size == 1 %}
<div class="cart-wrap"><h2>A little finishing touch.</h2><p>Add gift wrap for {{ wrap_product.price | money }}.</p>{% form 'product', wrap_product %}{{ form.errors | default_errors }}<input type="hidden" name="id" value="{{ wrap_product.selected_or_first_available_variant.id }}"><input type="hidden" name="quantity" value="1"><input type="hidden" name="return_to" value="{{ routes.cart_url }}"><button class="button secondary" type="submit">Add gift wrap {% render 'arrow' %}</button>{% endform %}</div>
{% endif %}
{% endif %}</section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
