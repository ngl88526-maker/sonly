<section class="section-pad faq-section"><div><span class="eyebrow">A FEW GOOD ANSWERS.</span><h2>Less guesswork.<br><em>More good socks.</em></h2><a class="text-link" href="{{ routes.root_url }}pages/help">Ask us anything {% render 'arrow' %}</a></div><div>{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="faq-answer">{{ block.settings.answer }}</div></details>{% endfor %}</div></section>
{% schema %}{"name":"Shopping questions","settings":[],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How do I find my fit?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Check our Size & Care guide for flat measurements and confirmed fit information before ordering.</p>"}]}],"presets":[{"name":"Shopping questions","blocks":[{"type":"question","settings":{"question":"How do I find my fit?","answer":"<p>Mystic Clouds has one size. Check our Size & Care guide and compare the flat measurements with a sock that fits you well.</p>"}},{"type":"question","settings":{"question":"Where can I see shipping costs?","answer":"<p>Available shipping services and rates are shown at checkout before payment. Find the store’s shipping policy in the footer or contact us for help.</p>"}},{"type":"question","settings":{"question":"Can I send socks as a gift?","answer":"<p>Yes. Add a personal message on the product page and request hidden packing-slip prices. Gift wrap appears in the bag when available.</p>"}},{"type":"question","settings":{"question":"What if a drop sells out?","answer":"<p>Join the email list to hear about upcoming styles. We will announce any restock plans when confirmed.</p>"}}]}]}{% endschema %}
