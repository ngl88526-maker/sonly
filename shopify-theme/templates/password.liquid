{% layout none %}
<!doctype html><html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ shop.name | escape }} — Coming soon</title>{{ content_for_header }}{{ 'sockonly.css' | asset_url | stylesheet_tag }}{{ 'theme.css' | asset_url | stylesheet_tag }}</head><body><main class="editorial-hero section-pad"><a class="wordmark brand-logo" href="{{ routes.root_url }}">{% render 'brand-logo' %}</a><h1>Something good<br><em>is afoot.</em></h1><p>{{ shop.password_message | escape }}</p>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label for="StorePassword">Store password</label><input id="StorePassword" name="password" type="password" required autocomplete="current-password"><button class="button navy" type="submit">Enter store</button>{% endform %}<p class="fine">Store owner? <a href="/admin">Sign in to Shopify</a></p></main></body></html>
